# Supabase Configuration (Free Tier 500 MB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# App Configuration
NEXTAUTH_SECRET=your-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# ERP integration (/api/erp/*). Machine callers send header `x-api-key`.
# Per-tenant keys (min 16 chars): "key1:<orgId>,key2:<orgId>"
ERP_API_KEYS=
# or a single key for the default org
ERP_API_KEY=

# Who may change an organization's plan (comma-separated usernames).
# Unset = Super Admin of the default (platform) org only.
PLATFORM_ADMIN_USERNAMES=
